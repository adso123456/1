# Docker 快照镜像配置模板。复制为 .env 后填写真实明文值。

# LLM
DEEPSEEK_API_KEY="replace_with_deepseek_api_key"
OPENCODE_API_KEY="replace_with_opencode_api_key"

# PostgreSQL：数据库运行在 Docker 宿主机时使用 host.docker.internal
DB_HOST="host.docker.internal"
DB_PORT="5433"
DB_NAME="gt_monitor"
DB_USER="replace_with_postgresql_user"
DB_PASSWORD="replace_with_postgresql_password"
DB_CONNECT_TIMEOUT="10"
DB_STATEMENT_TIMEOUT_MS="30000"
DB_LOCK_TIMEOUT_MS="5000"
DB_SSLMODE="prefer"

# MySQL
MYSQL_HOST="host.docker.internal"
MYSQL_PORT="3307"
MYSQL_DATABASE="lzh_monitor"
MYSQL_USER="replace_with_mysql_user"
MYSQL_PASSWORD="replace_with_mysql_password"
MYSQL_CONNECT_TIMEOUT="10"

# 使用 Fernet.generate_key() 生成
DATA_SOURCE_CREDENTIAL_KEY="replace_with_fernet_key"

# 容器固定路径
VANNA_SERVER_PORT="8000"
WATER_AGENT_HOST_PORT="5173"
WATER_AGENT_ADMIN_ALLOW_LAN="0"
VANNA_DATA_DIR="vanna_data"
AGENT_DATA_DIR="agent_data"
METADATA_INDEX_PATH="agent_data/column_metadata_index.json"
MYSQL_METADATA_INDEX_PATH="agent_data/mysql-lzh-monitor/column_metadata_index.json"
MYSQL_VANNA_DATA_DIR="agent_data/mysql-lzh-monitor/replace_with_current_revision"
DATA_SOURCE_CATALOG_PATH="agent_data/data_sources/catalog.sqlite3"
QUESTION_SUGGESTIONS_DIR="agent_data/question_suggestions"
WATER_AGENT_SYSTEM_DB_PATH="data/system/assistant_apps.sqlite3"
WATER_REPORT_OUTPUT_DIR="runtime/reports"
TRAINING_WORK_ROOT="runtime/training-work"
TRAINING_BACKUP_ROOT="runtime/training-backups"
WATER_REPORT_FONT_PATH="/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc"

# 性能与安全上限
LLM_CONNECT_TIMEOUT_SECONDS="10"
LLM_READ_TIMEOUT_SECONDS="90"
LLM_REQUEST_TIMEOUT_SECONDS="100"
LLM_MAX_RETRIES="1"
CHAT_REQUEST_DEADLINE_SECONDS="120"
AGENT_MAX_TOOL_ROUNDS="3"
LLM_MAX_CONCURRENCY="4"

# 动态数据源自分析：只读取受限样本，不执行精确全表 COUNT
DATA_SOURCE_ONBOARDING_WORKERS="1"
DATA_SOURCE_PROFILE_SAMPLE_ROWS="200"
DATA_SOURCE_PROFILE_MAX_COLUMNS="40"
DATA_SOURCE_PROFILE_ENUM_LIMIT="20"
DATA_SOURCE_SEMANTIC_LLM_ENABLED="1"
DATA_SOURCE_SEMANTIC_BATCH_TABLES="12"
DATA_SOURCE_SEMANTIC_TIMEOUT_SECONDS="60"
DATA_SOURCE_AUTO_SQL_MAX_EXAMPLES="30"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 运行开关
VANNA_DISABLE_LEGACY_SQL_EXAMPLES="0"
VANNA_REQUEST_TRACE_ENABLED="0"
VANNA_REQUEST_TRACE_DIR="runtime/traces"
VANNA_SQL_GUARD_TRACE_PATH="runtime/traces/sql_guard.jsonl"

# 中文 Embedding 离线运行
HF_HOME=".cache/huggingface"
HF_HUB_OFFLINE="1"
TRANSFORMERS_OFFLINE="1"
TOKENIZERS_PARALLELISM="false"
TZ="Asia/Shanghai"

# 嵌入应用演示
WATER_AGENT_HOST_DEMO_APP_ID="water-lan-demo"
WATER_AGENT_HOST_DEMO_ORIGIN="http://localhost:8000"
WATER_AGENT_HOST_DEMO_ALLOWED_SOURCE_IDS="postgresql-main,mysql-lzh-monitor"

# === 运行时受控自学习（Runtime Learning）V1 ===
# 总开关默认关闭。开启后：捕获 -> 独立候选库 -> LLM Judge -> 微批次发布（自动发布默认关闭）。
ONLINE_LEARNING_ENABLED=false
ONLINE_LEARNING_CAPTURE_ENABLED=true
ONLINE_LEARNING_JUDGE_ENABLED=true
ONLINE_LEARNING_AUTO_PUBLISH=false
ONLINE_LEARNING_JUDGE_MIN_CONFIDENCE=0.95
ONLINE_LEARNING_BATCH_SIZE=10
ONLINE_LEARNING_BATCH_MAX_WAIT_SECONDS=600
ONLINE_LEARNING_WORKER_INTERVAL_SECONDS=30
ONLINE_LEARNING_MAX_RESULT_ROWS=20
ONLINE_LEARNING_MAX_RESULT_BYTES=65536
ONLINE_LEARNING_MAX_JUDGE_ATTEMPTS=3
# 候选库默认 agent_data/learning_candidates.sqlite3；可用环境变量覆盖（相对路径按项目根解析）
# LEARNING_CANDIDATE_DB=data/learning_candidates.sqlite3

# 是否在启动时引导两个内置数据源（postgresql-main / mysql-lzh-monitor）。
# 默认 false：镜像发布到服务器后数据源为空，通过前端管理页添加。
# 本地开发需要在 .env 设置为 true。
DATA_SOURCE_BOOTSTRAP_BUILTINS=false
