DEEPSEEK_API_KEY=replace_with_deepseek_api_key

DB_HOST=localhost
DB_PORT=5433
DB_NAME=gt_monitor
DB_USER=replace_with_readonly_database_user
DB_PASSWORD=replace_with_database_password
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_SSLMODE=prefer

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=lzh_monitor
MYSQL_USER=replace_with_readonly_mysql_user
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_CONNECT_TIMEOUT=10

# B5 动态数据源目录。默认值位于 agent_data/data_sources/，不提交 Git。
# DATA_SOURCE_CATALOG_PATH=E:/custom/runtime/catalog.sqlite3
# 使用 Fernet.generate_key() 生成；仅保存在本机环境或被 Git 忽略的 .env。
DATA_SOURCE_CREDENTIAL_KEY=replace_with_fernet_key

# 问数性能与安全上限
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=90
LLM_REQUEST_TIMEOUT_SECONDS=100
LLM_MAX_RETRIES=1
CHAT_REQUEST_DEADLINE_SECONDS=120
AGENT_MAX_TOOL_ROUNDS=3
LLM_MAX_CONCURRENCY=4

# 水质日报/月报运行时输出目录及可选中文字体；均不提交到 Git。
# WATER_REPORT_OUTPUT_DIR=E:/3/_runtime/water-quality-reports
# WATER_REPORT_FONT_PATH=C:/Windows/Fonts/msyh.ttc

# 可选；默认使用项目根目录下的 vanna_data
# VANNA_DATA_DIR=E:/custom/path/to/vanna_data
AGENT_DATA_DIR=E:/path/to/agent_data

# MySQL Metadata 与 Memory 始终使用独立路径。
# MYSQL_METADATA_INDEX_PATH=E:/custom/path/to/mysql_metadata.json
# MYSQL_VANNA_DATA_DIR=E:/custom/path/to/mysql_vanna_data

# Agent 独立系统数据库；相对路径按项目根目录解析。
WATER_AGENT_SYSTEM_DB_PATH=data/system/assistant_apps.sqlite3

# 外部宿主 Demo 应用配置（无 Secret/Token，仅依赖 Origin 校验）。
WATER_AGENT_HOST_DEMO_APP_ID=local-water-assistant
WATER_AGENT_HOST_DEMO_ORIGIN=http://127.0.0.1:5174
WATER_AGENT_HOST_DEMO_ALLOWED_SOURCE_IDS=postgresql-main
