DEEPSEEK_API_KEY=replace_with_deepseek_api_key

DB_HOST=localhost
DB_PORT=5433
DB_NAME=gt_monitor
DB_USER=replace_with_readonly_database_user
DB_PASSWORD=replace_with_database_password
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_SSLMODE=prefer

# 可选；默认使用项目根目录下的 vanna_data
# VANNA_DATA_DIR=E:/custom/path/to/vanna_data
AGENT_DATA_DIR=E:/path/to/agent_data

# Agent 独立系统数据库；相对路径按项目根目录解析。
WATER_AGENT_SYSTEM_DB_PATH=data/system/assistant_apps.sqlite3

# 外部宿主 Demo 自己持有的小助手应用凭据。
WATER_AGENT_HOST_DEMO_APP_ID=local-water-assistant
WATER_AGENT_HOST_DEMO_APP_SECRET=replace_with_generated_application_secret
WATER_AGENT_HOST_DEMO_ORIGIN=http://127.0.0.1:5174
WATER_AGENT_HOST_DEMO_ALLOWED_SOURCE_IDS=postgresql-main
WATER_AGENT_HOST_DEMO_TOKEN_TTL_SECONDS=300

# 仅供 assistant_app_admin.py bootstrap-env 显式迁移旧单应用配置。
# Agent 服务不会从这些变量回退验证。
WATER_AGENT_EMBED_APP_ID=legacy-app-id
WATER_AGENT_EMBED_APP_SECRET=replace_with_legacy_secret
WATER_AGENT_EMBED_ENABLED=true
WATER_AGENT_EMBED_ALLOWED_ORIGINS=http://127.0.0.1:5174
WATER_AGENT_EMBED_ALLOWED_SOURCE_IDS=postgresql-main
WATER_AGENT_EMBED_TOKEN_TTL_SECONDS=300
